compilation_database_dir: .
output_directory: diagrams
diagrams:
  test_fsm_sequence:
    type: sequence
    glob:
      - tests/fsm/*.hpp
      - tests/*.cpp
    # combine_free_functions_into_file_participants: true
    generate_return_types: true
    # generate_return_values: true
    inline_lambda_messages: false
    generate_message_comments: false
    fold_repeated_activities: true
    generate_condition_statements: false
    message_name_width: 500
    # using_namespace:
    #   - fsm
    # include:
    #   elements:
    #     - r: ".*incrementer_fsm_t*"
      # method_types:
      #   - destructor
    #   paths:
    #     - include
    exclude:
      namespaces:
        - std
      # elements:
      #   - r: "*"
    from:
      - function: "FiniteStateMachine<int, IncrementState, CheckState, FinalState> &"
  test_fsm_class:
    type: class
    glob:
      - r: ".*\\.cpp"
    using_namespace:
      - fsm
    include_relations_also_as_members: true
    generate_packages: true
    package_type: directory
    include:
      context:
        - r: 'fsm::FiniteStateMachine.*'
      access:
        - public
      # relationships:
      #   - inheritance
      #   - association
      #   - dependency
      #   - composition
      #   - ownership
      #   - instantiation